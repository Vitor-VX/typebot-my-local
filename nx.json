{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "sync": {
    "applyChanges": true
  },
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript"
    },
    {
      "plugin": "@nx/next/plugin"
    },
    {
      "plugin": "@nx/vite/plugin"
    }
  ],
  "targetDefaults": {
    "dev": {
      "dependsOn": [
        "^db:generate",
        "^db:push"
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "analytics": true
}