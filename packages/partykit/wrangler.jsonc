{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "typebot-webhook-relay",
  "main": "src/webhookServer.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "Main"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Main"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "relay.trackyflow.sbs",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}